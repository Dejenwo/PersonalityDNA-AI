      "keyed": "-"
    },
    {
      "id": "bfm50-21",
      "number": 21,
      "text": "Start conversations.",
      "scale": "extraversion",
      "keyed": "+"
    },
    {
      "id": "bfm50-22",
      "number": 22,
      "text": "Am not interested in other people's problems.",
      "scale": "agreeableness",
      "keyed": "-"
    },
    {
      "id": "bfm50-23",
      "number": 23,
      "text": "Get chores done right away.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-24",
      "number": 24,
      "text": "Am easily disturbed.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-25",
      "number": 25,
      "text": "Have excellent ideas.",
      "scale": "openness",
      "keyed": "+"
    },
    {
      "id": "bfm50-26",
      "number": 26,
      "text": "Have little to say.",
      "scale": "extraversion",
      "keyed": "-"
    },
    {
      "id": "bfm50-27",
      "number": 27,
      "text": "Have a soft heart.",
      "scale": "agreeableness",
      "keyed": "+"
    },
    {
      "id": "bfm50-28",
      "number": 28,
      "text": "Often forget to put things back in their proper place.",
      "scale": "conscientiousness",
      "keyed": "-"
    },
    {
      "id": "bfm50-29",
      "number": 29,
      "text": "Get upset easily.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-30",
      "number": 30,
      "text": "Do not have a good imagination.",
      "scale": "openness",
      "keyed": "-"
    },
    {
      "id": "bfm50-31",
      "number": 31,
      "text": "Talk to a lot of different people at parties.",
      "scale": "extraversion",
      "keyed": "+"
    },
    {
      "id": "bfm50-32",
      "number": 32,
      "text": "Am not really interested in others.",
      "scale": "agreeableness",
      "keyed": "-"
    },
    {
      "id": "bfm50-33",
      "number": 33,
      "text": "Like order.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-34",
      "number": 34,
      "text": "Change my mood a lot.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-35",
      "number": 35,
      "text": "Am quick to understand things.",
      "scale": "openness",
      "keyed": "+"
    },
    {
      "id": "bfm50-36",
      "number": 36,
      "text": "Don't like to draw attention to myself.",
      "scale": "extraversion",
      "keyed": "-"
    },
    {
      "id": "bfm50-37",
      "number": 37,
      "text": "Take time out for others.",
      "scale": "agreeableness",
      "keyed": "+"
    },
    {
      "id": "bfm50-38",
      "number": 38,
      "text": "Shirk my duties.",
      "scale": "conscientiousness",
      "keyed": "-"
    },
    {
      "id": "bfm50-39",
      "number": 39,
      "text": "Have frequent mood swings.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-40",
      "number": 40,
      "text": "Use difficult words.",
      "scale": "openness",
      "keyed": "+"
    },
    {
      "id": "bfm50-41",
      "number": 41,
      "text": "Don't mind being the center of attention.",
      "scale": "extraversion",
      "keyed": "+"
    },
    {
      "id": "bfm50-42",
      "number": 42,
      "text": "Feel others' emotions.",
      "scale": "agreeableness",
      "keyed": "+"
    },
    {
      "id": "bfm50-43",
      "number": 43,
      "text": "Follow a schedule.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-44",
      "number": 44,
      "text": "Get irritated easily.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-45",
      "number": 45,
      "text": "Spend time reflecting on things.",
      "scale": "openness",
      "keyed": "+"
    },
    {
      "id": "bfm50-46",
      "number": 46,
      "text": "Am quiet around strangers.",
      "scale": "extraversion",
      "keyed": "-"
    },
    {
      "id": "bfm50-47",
      "number": 47,
      "text": "Make people feel at ease.",
      "scale": "agreeableness",
      "keyed": "+"
    },
    {
      "id": "bfm50-48",
      "number": 48,
      "text": "Am exacting in my work.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-49",
