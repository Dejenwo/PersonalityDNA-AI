    {
      "id": "bfm50-12",
      "number": 12,
      "text": "Insult people.",
      "scale": "agreeableness",
      "keyed": "-"
    },
    {
      "id": "bfm50-13",
      "number": 13,
      "text": "Pay attention to details.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-14",
      "number": 14,
      "text": "Worry about things.",
      "scale": "emotional_stability",
      "keyed": "-"
    },
    {
      "id": "bfm50-15",
      "number": 15,
      "text": "Have a vivid imagination.",
      "scale": "openness",
      "keyed": "+"
    },
    {
      "id": "bfm50-16",
      "number": 16,
      "text": "Keep in the background.",
      "scale": "extraversion",
      "keyed": "-"
    },
    {
      "id": "bfm50-17",
      "number": 17,
      "text": "Sympathize with others' feelings.",
      "scale": "agreeableness",
      "keyed": "+"
    },
    {
      "id": "bfm50-18",
      "number": 18,
      "text": "Make a mess of things.",
      "scale": "conscientiousness",
      "keyed": "-"
    },
    {
      "id": "bfm50-19",
      "number": 19,
      "text": "Seldom feel blue.",
