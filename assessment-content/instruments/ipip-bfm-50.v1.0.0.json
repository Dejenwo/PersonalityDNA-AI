      "keyed": "-"
    },
    {
      "id": "bfm50-03",
      "number": 3,
      "text": "Am always prepared.",
      "scale": "conscientiousness",
      "keyed": "+"
    },
    {
      "id": "bfm50-04",
      "number": 4,
      "text": "Get stressed out easily.",
