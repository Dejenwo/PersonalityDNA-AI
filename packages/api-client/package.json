{
  "name": "@pdna/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "python ../../services/backend/scripts/export_openapi.py && openapi-typescript openapi.json -o src/schema.d.ts",
    "check": "python ../../services/backend/scripts/export_openapi.py --check && openapi-typescript openapi.json --check -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
