# Copy to .env for local development. Never commit .env. No real secrets belong in this file.

# --- Local PostgreSQL (docker compose) ---
POSTGRES_USER=pdna
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pdna

# --- Backend (services/backend), all prefixed PDNA_ ---
PDNA_ENVIRONMENT=development
PDNA_DATABASE_URL=postgresql+psycopg://pdna:change-me-local-only@localhost:5432/pdna
PDNA_CORS_ORIGINS=["http://localhost:3000"]
PDNA_SESSION_CREATE_RATE_LIMIT=30

# Accounts. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars) in staging/production; optional in development (random per process).
PDNA_JWT_SECRET=
PDNA_WEB_BASE_URL=http://localhost:3000
PDNA_REFRESH_COOKIE_SECURE=false
PDNA_AUTH_RATE_LIMIT=10
# Email: "outbox" keeps emails in memory (development). Use "smtp" elsewhere.
PDNA_EMAIL_PROVIDER=outbox
PDNA_DEV_OUTBOX_ENDPOINT=true
# PDNA_EMAIL_FROM=PersonalityDNA <no-reply@example.com>
# PDNA_SMTP_HOST=
# PDNA_SMTP_PORT=587
# PDNA_SMTP_USERNAME=
# PDNA_SMTP_PASSWORD=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Not yet used: external services (see docs/KNOWN_ISSUES.md, "External dependencies") ---
# AI providers (Phase 8) - server side only, never NEXT_PUBLIC_
# PDNA_ANTHROPIC_API_KEY=
# PDNA_OPENAI_API_KEY=
# Payments (Phase 10)
# PDNA_STRIPE_SECRET_KEY=
# PDNA_STRIPE_WEBHOOK_SECRET=
# PDNA_REVENUECAT_WEBHOOK_AUTH=
# Monitoring
# PDNA_SENTRY_DSN=
